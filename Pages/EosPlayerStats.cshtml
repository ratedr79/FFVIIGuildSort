                    <select id="eos-mat-pick" class="form-select form-select-sm" style="max-width: 320px;">
                        <optgroup label="Materia">
                            @foreach (var m in Model.MateriaAddOptions.Where(o => !o.Refined))
                            {
                                <option value="@m.Key">@m.Name@(string.IsNullOrEmpty(m.Skill) ? "" : $" – {m.Skill}")@(m.Estimated ? " (estimated)" : "")</option>
                            }
                        </optgroup>
                        <optgroup label="Refined (Materia Hunt rewards, fixed stats)">
                            @foreach (var m in Model.MateriaAddOptions.Where(o => o.Refined))
                            {
                                <option value="@m.Key">@m.Name</option>
                            }
                        </optgroup>
                    </select>
                    <input type="number" id="eos-mat-count" class="form-control form-control-sm" style="width: 4.5rem;" min="1" max="50" value="1" title="How many copies" />
                    <button type="button" class="btn btn-sm btn-outline-primary" id="eos-mat-add-max">Add maxed</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="eos-mat-add">Add to customize</button>
