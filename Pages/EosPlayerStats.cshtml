                </div>
                <div class="form-check small mb-2">
                    <input class="form-check-input" type="checkbox" id="MateriaIgnoreBoostCap" name="MateriaIgnoreBoostCap" value="true" @(Model.MateriaIgnoreBoostCap ? "checked" : "") />
                    <label class="form-check-label" for="MateriaIgnoreBoostCap">
                        Let every stat use all the level's boosts (e.g. 6.4% MATK and 16% potency on one materia; the game's rolls can't give this)
                    </label>
                </div>
                <div id="eos-mat-list" class="d-flex flex-column gap-2"></div>
                <div class="small text-muted" id="eos-mat-empty">No materia in the list yet.</div>
                <input type="hidden" name="MateriaRequestsJson" id="eos-mat-json" value="@Model.MateriaRequestsJson" />
                <button type="submit" class="btn btn-sm btn-success mt-2"><i class="fas fa-download"></i> Add and download</button>
            </form>
            @if (Model.MateriaErrorMessage is not null)
            {
                <div class="alert alert-danger mt-2 mb-0 small">@Model.MateriaErrorMessage</div>
            }
        </div>
    </details>
    <script id="eos-mat-catalog" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MateriaAddOptions.Select(m => new
    {
        key = m.Key, name = m.Name, skill = m.Skill, max = m.MaxLevel, boosts = m.BoostLevels, refined = m.Refined, notes = m.Notes, sigils = m.Sigils,
        stats = m.Stats.Select(s => new { id = s.Id, label = s.Label, pct = s.Percent, i0 = s.InitMin, i1 = s.InitMax, e0 = s.EnhMin, e1 = s.EnhMax }),
    }), new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }))</script>

