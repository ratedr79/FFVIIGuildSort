    @{
        // Weapons share a handful of progression profiles; send each profile once.
        var wlProfiles = Model.WeaponProgress.Values
            .GroupBy(p => string.Join(",", p.MaxRelease.OrderBy(k => k.Key).Select(k => $"{k.Key}:{k.Value}")) + "#"
                + string.Join(",", p.LevelLimits.OrderBy(k => k.Key).Select(k => $"{k.Key}:{k.Value}")) + "#"
                + p.Overboost1 + "," + p.Overboost2 + "#" + string.Join(",", p.LevelExp))
            .ToList();
    }
    <script id="eos-wlevel-catalog" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        profiles = wlProfiles.Select(g =>
        {
            var p = g.First();
            return new { rel = p.MaxRelease.OrderBy(k => k.Key).Select(k => new[] { k.Key, k.Value }), cap = p.LevelLimits, ob1 = p.Overboost1, ob2 = p.Overboost2, exp = p.LevelExp };
        }),
        weaponProfile = wlProfiles.SelectMany((g, i) => g.Select(p => (p.WeaponId, i))).ToDictionary(x => x.WeaponId, x => x.i),
        weapons = Model.BrandWeaponNames,
    }, new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }))</script>

