@page
@model FFVIIEverCrisisAnalyzer.Pages.EosPlayerStatsModel
@{
    ViewData["Title"] = "EOS Player Stats";
    var s = Model.Stats;
    string N(long v) => v.ToString("N0");
    Microsoft.AspNetCore.Html.IHtmlContent Rank(FFVIIEverCrisisAnalyzer.Models.EosEventRank e) =>
        new Microsoft.AspNetCore.Html.HtmlString(e.FinalRank > 0
            ? "#" + N(e.FinalRank) + (e.EarnedBadge ? "<i class=\"fas fa-medal eos-badge-icon\" title=\"Earned a badge\"></i>" : "")
            : "–");
    Microsoft.AspNetCore.Html.IHtmlContent RankSummary(List<FFVIIEverCrisisAnalyzer.Models.EosEventRank> list, int top)
    {
        var ranked = list.Where(e => e.FinalRank > 0).ToList();
        if (ranked.Count == 0) return Microsoft.AspNetCore.Html.HtmlString.Empty;
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<p class=\"eos-best\">Best #{N(ranked.Min(e => e.FinalRank))} · {ranked.Count(e => e.FinalRank <= top)} of {ranked.Count} in the top {top}</p>");
    }

    // Detail tables for the modals are collected while rendering rows and emitted as <template>s after the tabs.
    var details = new List<Microsoft.AspNetCore.Html.IHtmlContent>();
    int AddDetail(Microsoft.AspNetCore.Html.IHtmlContent? c) { details.Add(c ?? Microsoft.AspNetCore.Html.HtmlString.Empty); return details.Count - 1; }
    string H(string? v) => System.Net.WebUtility.HtmlEncode(v ?? string.Empty);
    Microsoft.AspNetCore.Html.IHtmlContent Table(string head, IEnumerable<string> rows, string? note = null) =>
        new Microsoft.AspNetCore.Html.HtmlString(
            "<div class=\"table-responsive\"><table class=\"table table-sm table-striped eos-table mb-2\"><thead><tr>" + head + "</tr></thead><tbody>"
            + string.Concat(rows) + "</tbody></table></div>" + (note == null ? "" : "<p class=\"text-muted small mb-0\">" + note + "</p>"));
    Microsoft.AspNetCore.Html.IHtmlContent StageTable(List<FFVIIEverCrisisAnalyzer.Models.EosEventStage> stages, bool damage) => Table(
        "<th>Stage</th><th class=\"num\">High score</th>" + (damage ? "" : "<th class=\"num\">Stage level</th>") + "<th class=\"num\">Clears</th><th>Team for the best score</th><th>Memoria</th><th class=\"num\">Modifiers</th><th>Best set</th>",
        stages.Select(x => $"<tr><td>{H(x.Name)}</td><td class=\"num\">{(x.HighScore > 0 ? N(x.HighScore) : "–")}</td>" + (damage ? "" : $"<td class=\"num\">{(x.StageLevel is int sl ? sl.ToString() : "–")}</td>") + $"<td class=\"num\">{(x.Clears > 0 ? N(x.Clears) : "–")}</td><td>{H(x.Team ?? "–")}</td><td>{(x.Team == null ? "–" : x.WithMemoria ? "Yes" : "No")}</td><td class=\"num\">{(x.Modifiers > 0 ? x.Modifiers.ToString() : "–")}</td><td>{x.BestSet?.ToString("MMM d, yyyy") ?? ""}</td></tr>"),
        (damage ? "Damage" : "Crisis") + " stages you played. Modifiers is how many buffs/debuffs were selected for the best run.");
    Microsoft.AspNetCore.Html.IHtmlContent FightTable(List<FFVIIEverCrisisAnalyzer.Models.EosGuildFight> fights)
    {
        var guild = fights.Any(x => x.GuildScore != null);
        return Table(
            "<th>Boss</th><th class=\"num\">Your high score</th><th class=\"num\">Practice best</th>" + (guild ? "<th class=\"num\">Guild defeats</th><th class=\"num\">Guild score</th>" : ""),
            fights.Select(x => $"<tr><td>{new string('★', Math.Max(x.Stars, 0))} {H(x.Boss)}</td><td class=\"num\">{(x.HighScore > 0 ? N(x.HighScore) : "–")}</td><td class=\"num\">{(x.PracticeBest > 0 ? N(x.PracticeBest) : "–")}</td>"
                + (guild ? $"<td class=\"num\">{(x.GuildDefeats is long gd ? N(gd) : "–")}</td><td class=\"num\">{(x.GuildScore is long gs ? N(gs) : "–")}</td>" : "") + "</tr>"),
            guild ? "Guild totals come from your current guild, so they only appear for battles you fought with it." : null);
    }
    Microsoft.AspNetCore.Html.IHtmlContent BattleTable(List<FFVIIEverCrisisAnalyzer.Models.EosDungeonBattle> battles) => Table(
        "<th class=\"num\">#</th><th>Type</th><th>Enemies</th><th class=\"num\">Best boss enhancement beaten</th><th class=\"num\">Wins</th>",
        battles.Select(x => $"<tr><td class=\"num\">{x.Idx}</td><td>{H(x.Kind)}</td><td>{H(x.Enemy)}</td><td class=\"num\">{(x.MaxEnhancement is int me ? (me == 0 ? "Base" : "+" + me) : "–")}</td><td class=\"num\">{(x.Wins > 0 ? N(x.Wins) : "–")}</td></tr>"),
        "Bosses get stronger as a run goes on; enhancement is the strongest version you beat.");
}

<style>
    .eos-upload { border: 1px dashed #b9a9d6; border-radius: 0.7rem; background: #faf8fd; padding: 1rem 1.1rem; }
    .eos-header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; margin: 1.2rem 0 0.9rem; }
    .eos-header h2 { margin: 0; font-weight: 700; color: #332b42; }
    .eos-header .eos-guild { color: #6b5b8a; font-weight: 600; }
    .eos-header .eos-message { color: #7a7289; font-style: italic; width: 100%; }
    .eos-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.8rem; margin-bottom: 1.4rem; }
    /* Summary cards: six equal columns on wide screens, then 3 / 2 / 1 so no row is left with a single card. */
    .eos-cards-summary { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    @@media (max-width: 1399.98px) { .eos-cards-summary { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @@media (max-width: 767.98px) { .eos-cards-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 479.98px) { .eos-cards-summary { grid-template-columns: minmax(0, 1fr); } }
    .eos-card { border: 1px solid #ddd3ed; border-radius: 0.7rem; background: #fff; box-shadow: 0 2px 8px rgba(39, 26, 65, 0.08); padding: 0.75rem 0.9rem; }
    .eos-card h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #6b5b8a; margin: 0 0 0.45rem; }
    .eos-card .eos-big { font-size: 1.55rem; font-weight: 700; color: #332b42; line-height: 1.15; font-variant-numeric: tabular-nums; }
    .eos-card dl { display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 0.8rem; margin: 0.4rem 0 0; font-size: 0.9rem; }
    .eos-card dt { font-weight: 400; color: #5c566a; }
    .eos-card dd { margin: 0; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
    .eos-tabs .nav-link { color: #4b3f63; }
    .eos-tabs .nav-link.active { font-weight: 700; }
    .eos-tab-body { padding-top: 0.8rem; }
    .eos-table td.num, .eos-table th.num { text-align: right; font-variant-numeric: tabular-nums; }
    .eos-materia th, .eos-materia td { text-align: right; font-variant-numeric: tabular-nums; }
    .eos-materia th:first-child, .eos-materia td:first-child { text-align: left; }
    .eos-filter { max-width: 220px; }
    .eos-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; width: 100%; }
    .eos-chip { background: #f1ecf8; border: 1px solid #ddd3ed; border-radius: 999px; padding: 0.15rem 0.65rem; font-size: 0.85rem; color: #332b42; }
    .eos-chip i { color: #7d5fb3; margin-right: 0.2rem; }
    .eos-card-wide { grid-column: 1 / -1; }
    .eos-progress-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); column-gap: 2rem; }
    .eos-progress-row { display: grid; grid-template-columns: 11rem 1fr auto; align-items: center; gap: 0.6rem; font-size: 0.88rem; margin: 0.3rem 0; }
    .eos-bar { height: 0.5rem; background: #ece6f5; border-radius: 999px; overflow: hidden; }
    .eos-bar > div { height: 100%; background: #7d5fb3; border-radius: 999px; }
    .eos-progress-num { font-weight: 600; font-variant-numeric: tabular-nums; min-width: 6.5rem; text-align: right; }
    .eos-section-title { text-transform: uppercase; letter-spacing: 0.05em; color: #6b5b8a; font-weight: 700; }
    .eos-tabs { flex-wrap: wrap; }
    .eos-badge-icon { color: #c9971c; margin-left: 0.3rem; }
    .eos-best { font-size: 0.85rem; color: #6b5b8a; margin: -0.2rem 0 0.4rem; }
    .eos-badge-card .eos-big small { font-size: 0.9rem; font-weight: 600; color: #6b5b8a; }
    .eos-badge-card p { font-size: 0.85rem; color: #5c566a; margin: 0.25rem 0 0.4rem; }
    .eos-badge-card ul { font-size: 0.85rem; margin: 0; padding-left: 1.1rem; columns: 3; column-gap: 1.2rem; }
    @@media (max-width: 700px) { .eos-badge-card ul { columns: 1; } }
    /* Mobile: cards and wide tables must never push the page sideways. */
    .eos-card { min-width: 0; overflow-wrap: anywhere; }
    .eos-tab-body .dt-layout-table > .dt-layout-cell, .eos-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .eos-tab-body .form-select { max-width: 100%; }
    .eos-tab-body .d-flex { flex-wrap: wrap; }
    .eos-tab-select { display: none; }
    @@media (max-width: 767.98px) {
        /* The site layout adds ~40px padding per side; give the data that room back on phones. */
        .container:has(> main .eos-page) { padding-left: 0.4rem; padding-right: 0.4rem; }
        .eos-page { padding-left: 0.2rem; padding-right: 0.2rem; }
        .eos-page .row { --bs-gutter-x: 1rem; }
        .eos-tabs { display: none; }
        .eos-tab-select { display: block; font-weight: 600; }
        .eos-table { font-size: 0.82rem; }
        .eos-table td, .eos-table th { white-space: nowrap; }
        .eos-table td:first-child { white-space: normal; min-width: 9rem; }
        .eos-progress-row { grid-template-columns: minmax(0, 1fr) auto; row-gap: 0.15rem; }
        .eos-progress-row > span:first-child { grid-column: 1 / -1; }
        .eos-progress-num { min-width: 0; }
        /* Keep the page-size and search controls on one compact row. */
        .eos-tab-body .dt-container > .dt-layout-row:not(.dt-layout-table) { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.4rem; margin: 0.3rem 0; }
        .eos-tab-body .dt-container > .dt-layout-row:not(.dt-layout-table) > .dt-layout-cell { display: flex; margin: 0; padding: 0; }
        .eos-tab-body div.dt-container .dt-search { display: flex; align-items: center; gap: 0.3rem; }
        .eos-tab-body div.dt-container .dt-search input { width: 9.5rem; margin-left: 0; }
        .eos-tab-body div.dt-container .dt-info { font-size: 0.8rem; }
    }
</style>

<div class="container-fluid eos-page">
    <h1 class="h3 mt-3"><i class="fas fa-chart-bar text-primary"></i> EOS Player Stats</h1>
    <p class="text-muted mb-3">Upload the account export (.json) from EOS to see your pulls, collection, rankings, badges and more. Purchases are only shown if you tick "Show purchases". The file is read in memory and never saved.</p>

    <form method="post" enctype="multipart/form-data" class="eos-upload">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <input type="file" name="UploadedFile" accept=".json,application/json" class="form-control" style="max-width: 420px;" required />
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="IncludePurchases" name="IncludePurchases" value="true" @(Model.IncludePurchases ? "checked" : "") />
                <label class="form-check-label small" for="IncludePurchases" title="Adds a Purchases tab with paid packs (list price in USD) and shop exchanges.">Show purchases</label>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> Show my stats</button>
            @if (Model.FileName is not null && s is not null)
            {
                <span class="text-muted small">Showing <strong>@Model.FileName</strong></span>
            }
        </div>
    </form>

    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
    }

    @if (s is not null)
    {
        // Shareable summary: the headline numbers, rendered client-side as text and as an image.
        var bestRank = s.CrisisEvents.Concat(s.DamageRankings).Where(e => e.FinalRank > 0).OrderBy(e => e.FinalRank).FirstOrDefault();
        var ownedWeapons = s.Weapons.Where(w => w.Owned).ToList();
        var ultimates = ownedWeapons.Count(w => w.Stars == 6);
        var allTowers = s.Towers.Concat(s.SingularityTowers).ToList();
        var shareTiles = new List<object>();
        void Tile(string label, string value, string? sub = null) => shareTiles.Add(new { label, value, sub });
        Tile("Pulls", N(s.TotalPulls), $"{N(s.TotalCrystalPulls)} with crystals");
        if (s.Battles.TotalWins > 0) Tile("Battles won", N(s.Battles.TotalWins), $"{N(s.Battles.CoopWins)} in co-op");
        if (s.Logins.DaysLoggedIn > 0) Tile("Days logged in", N(s.Logins.DaysLoggedIn), s.Logins.DaysAvailable > 0 ? $"{s.Logins.DaysLoggedIn * 100 / s.Logins.DaysAvailable}% of days" : null);
        if (s.MaxPower is long shareMaxPower) Tile("Max power", N(shareMaxPower));
        Tile("Weapons", $"{N(ownedWeapons.Count)} / {N(s.Weapons.Count)}", ultimates > 0 ? $"{ultimates} ultimate" : null);
        Tile("Outfits", $"{N(s.Outfits.Count(o => o.Owned))} / {N(s.Outfits.Count)}");
        if (s.Memoria.Count > 0) Tile("Memoria", $"{N(s.Memoria.Count(x => x.Owned))} / {N(s.Memoria.Count)}");
        if (s.Badges.Count > 0) Tile("Badges", N(s.Badges.Sum(b => b.Count)));
        if (bestRank is not null) Tile("Best event rank", "#" + N(bestRank.FinalRank), s.DamageRankings.Contains(bestRank) ? bestRank.Name + " damage ranking" : bestRank.Name);
        if (allTowers.Sum(t => t.Total) > 0) Tile("Tower floors", $"{N(allTowers.Sum(t => Math.Min(t.Cleared, t.Total)))} / {N(allTowers.Sum(t => t.Total))}");
        if (s.DamageChallenges.Count > 0) Tile("Damage challenges maxed", $"{s.DamageChallenges.Count(x => x.IsMaxed)} / {s.DamageChallenges.Count}");
        Tile("Materia crafted", N(s.Materia.TotalCrafted));
        var share = new
        {
            name = string.IsNullOrWhiteSpace(s.PlayerName) ? "Unnamed player" : s.PlayerName,
            guild = s.GuildName,
            rank = s.PlayerRank,
            since = s.AccountCreated?.ToString("MMM d, yyyy"),
            days = s.AccountCreated is DateTime shareCreated ? (long)(DateTime.UtcNow - shareCreated).TotalDays : (long?)null,
            tiles = shareTiles.Take(12).ToList(),
        };
        <script type="application/json" id="eos-share-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(share))</script>
        <div class="modal fade" id="eos-share-modal" tabindex="-1" aria-labelledby="eos-share-title" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h6" id="eos-share-title">Share your summary</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <img id="eos-share-img" class="img-fluid rounded border mb-3" alt="Summary image of your EOS stats" />
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <button type="button" class="btn btn-primary btn-sm" id="eos-share-native" hidden><i class="fas fa-share-nodes"></i> Share…</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="eos-share-copyimg"><i class="fas fa-image"></i> Copy image</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="eos-share-download"><i class="fas fa-download"></i> Save image</button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="eos-share-copytext"><i class="fas fa-copy"></i> Copy as text</button>
                            <span class="small text-muted align-self-center" id="eos-share-status" role="status"></span>
                        </div>
                        <p class="small text-muted mb-0">The image and text are made in your browser from the file you uploaded; nothing is sent anywhere. Purchases are never included.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="eos-header">
            <h2>@(string.IsNullOrWhiteSpace(s.PlayerName) ? "Unnamed player" : s.PlayerName)</h2>
            @if (!string.IsNullOrWhiteSpace(s.GuildName))
            {
                <span class="eos-guild"><i class="fas fa-shield-halved"></i> @s.GuildName</span>
            }
            @if (!string.IsNullOrWhiteSpace(s.ProfileMessage))
            {
                <span class="eos-message">"@s.ProfileMessage"</span>
            }
            <div class="eos-chips">
                @if (s.PlayerRank > 0)
                {
                    <span class="eos-chip"><i class="fas fa-star"></i> Rank @s.PlayerRank <span class="text-muted">/ @s.MaxPlayerRank</span></span>
                }
                @if (s.AccountCreated is DateTime created)
                {
                    <span class="eos-chip"><i class="fas fa-calendar"></i> Playing since @created.ToString("MMM d, yyyy") <span class="text-muted">(@N((long)(DateTime.UtcNow - created).TotalDays) days)</span></span>
                }
                @if (s.MaxPower is long maxPower)
                {
                    <span class="eos-chip"><i class="fas fa-bolt"></i> Max power @N(maxPower)</span>
                }
                @if (s.GuildLevel is int guildLevel)
                {
                    <span class="eos-chip"><i class="fas fa-shield-halved"></i> Guild Lv @guildLevel@(s.GuildJoined is DateTime joined ? $" · joined {joined:MMM d, yyyy}" : "")</span>
                }
            </div>
            <button type="button" class="btn btn-primary btn-sm" id="eos-share-btn"><i class="fas fa-share-nodes"></i> Share summary</button>
        </div>

        @if (s.Warnings.Count > 0)
        {
            <div class="alert alert-warning small">
                Some IDs couldn't be matched to game data, so a few names may show as numbers:
                <ul class="mb-0">@foreach (var w in s.Warnings) { <li>@w</li> }</ul>
            </div>
        }

        <div class="eos-cards eos-cards-summary">
            <div class="eos-card">
                <h3>Draws</h3>
                <div class="eos-big">@N(s.TotalPulls) pulls</div>
                <dl>
                    <dt>Crystal pulls</dt><dd>@N(s.TotalCrystalPulls)</dd>
                    <dt>Free / ticket pulls</dt><dd>@N(s.TotalFreePulls)</dd>
                    <dt>Est. crystals spent</dt><dd>@N(s.EstimatedCrystalsUsedForPulls)</dd>
                </dl>
            </div>
            <div class="eos-card">
                <h3>Gil</h3>
                <div class="eos-big">@N(s.Gil.Count)</div>
                <dl>
                    <dt>Lifetime obtained</dt><dd>@N(s.Gil.TotalObtained)</dd>
                    <dt>Lifetime spent</dt><dd>@N(s.Gil.TotalObtained - s.Gil.Count)</dd>
                </dl>
            </div>
            <div class="eos-card">
                <h3>Crystals</h3>
                <div class="eos-big">@N(s.TotalCrystals)</div>
                <dl>
                    <dt>Red crystals</dt><dd>@N(s.RedCrystals)</dd>
                    <dt>Blue crystals</dt><dd>@N(s.BlueCrystals)</dd>
                    <dt>Crystal ads watched</dt><dd>@N(s.TotalCrystalAdsViewed)</dd>
                </dl>
            </div>
            @if (s.Battles.TotalWins > 0)
            {
                <div class="eos-card">
                    <h3>Battles won</h3>
                    <div class="eos-big">@N(s.Battles.TotalWins)</div>
                    <dl>
                        <dt>Solo</dt><dd>@N(s.Battles.SoloWins)</dd>
                        <dt>Co-op</dt><dd>@N(s.Battles.CoopWins)</dd>
                        <dt>Story battles cleared</dt><dd>@N(s.Battles.StoryBattlesCleared)</dd>
                        @if (s.CoopPlayersMet is long met) { <dt>Co-op players met</dt><dd>@N(met)</dd> }
                    </dl>
                </div>
            }
            <div class="eos-card">
                <h3>Highwind treasure battles</h3>
                <div class="eos-big">@N(s.TotalHighwindCactuars + s.TotalHighwindGoldCactuars + s.TotalHighwindGoldBombs) wins</div>
                <dl>
                    <dt>Cactuars</dt><dd>@N(s.TotalHighwindCactuars)</dd>
                    <dt>Gold Cactuars</dt><dd>@N(s.TotalHighwindGoldCactuars)</dd>
                    <dt>Gold Bombs</dt><dd>@N(s.TotalHighwindGoldBombs)</dd>
                </dl>
            </div>
            <div class="eos-card">
                <h3>Materia</h3>
                <div class="eos-big">@N(s.Materia.TotalCrafted) crafted</div>
                <dl>
                    <dt>Currently owned</dt><dd>@N(s.MateriaOwned.Count)</dd>
                    <dt>Total obtained</dt><dd>@N(s.Materia.TotalObtained)</dd>
                    <dt>5★ crafted</dt><dd>@N(s.Materia.CraftedByStar[4])</dd>
                    <dt>5★ obtained</dt><dd>@N(s.Materia.ObtainedByStar[4])</dd>
                </dl>
            </div>
            @if (s.Collection.Count > 0)
            {
                <div class="eos-card eos-card-wide">
                    <h3>Collection</h3>
                    <div class="eos-progress-grid">
                        @foreach (var c in s.Collection)
                        {
                            <div class="eos-progress-row">
                                <span>@c.Name</span>
                                <div class="eos-bar" role="progressbar" aria-label="@c.Name" aria-valuenow="@c.Percent" aria-valuemin="0" aria-valuemax="100"><div style="width: @c.Percent%"></div></div>
                                <span class="eos-progress-num">@N(c.Owned) / @N(c.Total)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <select class="form-select eos-tab-select mb-2" aria-label="Section"></select>
        <ul class="nav nav-tabs eos-tabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#eos-draws" type="button" role="tab">Draws (@s.Draws.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-characters" type="button" role="tab">Characters (@s.Characters.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-parties" type="button" role="tab">Parties (@s.Parties.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-weapons" type="button" role="tab">Weapons (@s.Weapons.Count(w => w.Owned) / @s.Weapons.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-outfits" type="button" role="tab">Outfits (@s.Outfits.Count(o => o.Owned) / @s.Outfits.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-items" type="button" role="tab">Items (@s.Items.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-shop" type="button" role="tab">Shop (@N(s.ShopExchanges.Sum(x => x.Count)))</button></li>
            @if (s.LimitedOffers.Count > 0)
            {
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-offers" type="button" role="tab">Limited offers (@s.LimitedOffers.Count)</button></li>
            }
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-materia" type="button" role="tab">Materia (@N(s.MateriaOwned.Count))</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-memoria" type="button" role="tab">Memoria (@s.Memoria.Count(x => x.Owned) / @s.Memoria.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-skills" type="button" role="tab">Skills (@s.Skills.Count(x => x.Owned) / @s.Skills.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-chocobos" type="button" role="tab">Chocobos (@s.Chocobos.Count)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-highwind" type="button" role="tab">Highwind &amp; Guild</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-battles" type="button" role="tab">Battles (@N(s.Battles.TotalWins) wins)</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-records" type="button" role="tab">Play records</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-rankings" type="button" role="tab">Rankings</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-badges" type="button" role="tab">Badges (@s.Badges.Sum(b => b.Count))</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-challenges" type="button" role="tab">Challenges</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-missions" type="button" role="tab">Missions (@N(s.Missions.Count(x => x.Complete)) / @N(s.Missions.Count))</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-passes" type="button" role="tab">Passes &amp; achievements</button></li>
            @if (s.Purchases is not null)
            {
                <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#eos-purchases" type="button" role="tab">Purchases</button></li>
            }
        </ul>

        <div class="tab-content eos-tab-body">
            <div class="tab-pane fade show active" id="eos-draws" role="tabpanel">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label for="eos-draw-type" class="small text-muted mb-0">Draw type</label>
                    <select id="eos-draw-type" class="form-select form-select-sm eos-filter">
                        <option value="">All</option>
                        @foreach (var t in s.Draws.Select(d => d.TypeLabel).Distinct().OrderBy(x => x))
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <table id="eos-draws-table" class="table table-sm table-striped eos-table w-100">
                    <thead>
                        <tr><th>Draw</th><th>Type</th><th>Last pulled</th><th class="num">Pulls</th><th class="num">Crystal pulls</th><th class="num">Stamps</th><th class="num">Stamp pages</th><th class="num">Est. crystals</th><th class="num">ID</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in s.Draws)
                        {
                            <tr>
                                <td>@d.Name@if (!string.IsNullOrEmpty(d.FeaturedWeapons)) {<div class="small text-muted">Featured: @d.FeaturedWeapons</div>}</td>
                                <td>@d.TypeLabel</td>
                                <td data-order="@(d.LastPulled?.Ticks ?? 0)">@(d.LastPulled?.ToString("MMM d, yyyy") ?? "")</td>
                                <td class="num">@N(d.TotalPulls)</td>
                                <td class="num">@N(d.CrystalPulls)</td>
                                <td class="num">@N(d.TotalStamps)</td>
                                <td class="num">@N(d.TotalStampPages)</td>
                                <td class="num">@N(d.EstimatedCrystalsUsed)</td>
                                <td class="num">@d.Id</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (s.Wishlists.Count > 0)
                {
                    <h2 class="h6 eos-section-title mt-4">Wishlist picks (@s.Wishlists.Count lists, @N(s.Wishlists.Sum(w => w.Changed)) slots changed from the default)</h2>
                    <table id="eos-wish-table" class="table table-sm table-striped eos-table w-100">
                        <thead><tr><th>Draws</th><th>Last pulled</th><th>Picks</th><th class="num">Changed</th></tr></thead>
                        <tbody>
                            @foreach (var w in s.Wishlists)
                            {
                                <tr>
                                    <td>@w.Banners</td>
                                    <td data-order="@(w.LastPulled?.Ticks ?? 0)">@(w.LastPulled?.ToString("MMM d, yyyy") ?? "")</td>
                                    <td>@for (var pi = 0; pi < w.Picks.Count; pi++) { var p = w.Picks[pi]; if (pi > 0) { <text> · </text> } if (p.Changed) { <strong title="Changed from the default pick">@p.Weapon</strong> } else { <span class="text-muted">@p.Weapon</span> } }</td>
                                    <td class="num">@w.Changed</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="text-muted small">Bold weapons are ones the player picked instead of the game's default. The export doesn't date the wishlist itself, so lists are ordered by the last time the player pulled on those draws; lists for draws never pulled have no date.</p>
                }

                @if (s.BoxDraws.Count > 0)
                {
                    <h2 class="h6 eos-section-title mt-4">Event box draws (@N(s.BoxDraws.Sum(b => b.Draws)) draws, @N(s.BoxDraws.Sum(b => b.BoxesReset)) boxes reset)</h2>
                    <table id="eos-box-table" class="table table-sm table-striped eos-table w-100">
                        <thead><tr><th>Event</th><th>Box</th><th class="num">Draws</th><th class="num">Boxes reset</th><th>Ticket</th><th class="num">Tickets used</th><th>Last ticket earned</th></tr></thead>
                        <tbody>
                            @foreach (var b in s.BoxDraws)
                            {
                                <tr><td>@b.Event</td><td>@b.Box</td><td class="num">@N(b.Draws)</td><td class="num">@N(b.BoxesReset)</td><td>@b.Ticket</td><td class="num">@N(b.TicketsUsed)</td><td data-order="@(b.LastTicket?.Ticks ?? 0)">@(b.LastTicket?.ToString("MMM d, yyyy") ?? "")</td></tr>
                            }
                        </tbody>
                    </table>
                    <p class="text-muted small">Event boxes (Victory Draw / Silver Victory Draw) were prize boxes during events: tickets earned from event battles were spent to draw from a box with a fixed set of prizes, and the box could be reset once its main prize was taken. Draws = tickets used ÷ tickets per draw.</p>
                }
            </div>

            <div class="tab-pane fade" id="eos-weapons" role="tabpanel">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label for="eos-weapon-status" class="small text-muted mb-0">Show</label>
                    <select id="eos-weapon-status" class="form-select form-select-sm eos-filter">
                        <option value="">All</option><option value="Owned">Owned</option><option value="Missing">Missing</option>
                    </select>
                </div>
                <table id="eos-weapons-table" class="table table-sm table-striped eos-table w-100">
                    <thead><tr><th>Weapon</th><th>Character</th><th>Status</th><th>Rarity</th><th class="num">Level</th><th>Overboost</th><th class="num" title="This weapon's own Parts item held (200 parts = one rarity or overboost step)">Parts</th><th class="num">Times pulled</th><th>First obtained</th><th class="num">Voucher exchanges</th><th>Last voucher exchange</th></tr></thead>
                    <tbody>
                        @foreach (var w in s.Weapons)
                        {
                            <tr><td>@w.Name</td><td>@w.Character</td><td>@(w.Owned ? "Owned" : "Missing")</td><td data-order="@w.Stars">@(w.Stars > 0 ? w.Stars + "★" + (w.Stars == 6 ? " Ultimate" : "") : "")</td><td class="num" data-order="@w.Level">@(w.Owned && w.Level > 0 ? (w.MaxLevel > 0 ? $"{w.Level} / {w.MaxLevel}" : w.Level.ToString()) : "")</td><td data-order="@w.OverboostOrder">@w.OverboostLabel</td><td class="num" data-order="@(w.Parts ?? -1)" title="@(w.PartsObtained > 0 ? N(w.PartsObtained) + " obtained in total" : "")">@(w.Parts is long wp ? N(wp) : "")</td><td class="num">@N(w.GachaPulls)</td><td data-order="@(w.FirstObtained?.Ticks ?? 0)">@(w.FirstObtained?.ToString("MMM d, yyyy") ?? "")</td><td class="num">@(w.VoucherExchanges > 0 ? N(w.VoucherExchanges) : "")</td><td data-order="@(w.LastVoucherExchange?.Ticks ?? 0)">@(w.LastVoucherExchange?.ToString("MMM d, yyyy") ?? "")</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="eos-outfits" role="tabpanel">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <label for="eos-outfit-status" class="small text-muted mb-0">Show</label>
                    <select id="eos-outfit-status" class="form-select form-select-sm eos-filter">
                        <option value="">All</option><option value="Owned">Owned</option><option value="Missing">Missing</option>
                    </select>
                </div>
                <table id="eos-outfits-table" class="table table-sm table-striped eos-table w-100">
                    <thead><tr><th>Outfit</th><th>Character</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var o in s.Outfits)
                        {
                            <tr><td>@o.Name</td><td>@o.Character</td><td>@(o.Owned ? "Owned" : "Missing")</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="eos-items" role="tabpanel">
                <table id="eos-items-table" class="table table-sm table-striped eos-table w-100">
                    <thead><tr><th>Item</th><th class="num">Owned</th><th class="num">Lifetime obtained</th><th>First obtained</th><th>Last obtained</th></tr></thead>
                    <tbody>
                        @foreach (var i in s.Items)
                        {
                            <tr><td>@i.Name</td><td class="num">@N(i.Count)</td><td class="num">@N(i.TotalObtained)</td><td data-order="@(i.FirstObtained?.Ticks ?? 0)">@(i.FirstObtained?.ToString("MMM d, yyyy") ?? "")</td><td data-order="@(i.LastObtained?.Ticks ?? 0)">@(i.LastObtained?.ToString("MMM d, yyyy") ?? "")</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="eos-shop" role="tabpanel">
                <div class="d-flex gap-2">
                    <select id="eos-shop-filter" class="form-select form-select-sm w-auto mb-2" aria-label="Shop"><option value="">All shops</option>
                        @foreach (var sh in s.ShopExchanges.Select(x => x.Shop).Distinct().OrderBy(x => x))
                        {
                            <option value="@sh">@sh</option>
                        }
                    </select>
                </div>
                <table id="eos-shop-table" class="table table-sm table-striped eos-table w-100">
                    <thead><tr><th>Item</th><th>Shop</th><th class="num">Times bought</th><th>Last bought</th></tr></thead>
                    <tbody>
                        @foreach (var x in s.ShopExchanges)
                        {
                            <tr><td>@x.Name</td><td>@x.Shop</td><td class="num">@N(x.Count)</td><td data-order="@(x.LastPurchased?.Ticks ?? 0)">@(x.LastPurchased?.ToString("MMM d, yyyy") ?? "")</td></tr>
                        }
                    </tbody>
                </table>
                <p class="text-muted small">Exchanges in in-game shops (medals, event currency, vouchers…). The game keeps only the latest purchase date for each item, not every purchase. Real-money packs are only shown under Purchases when "Show purchases" is ticked.</p>
            </div>

            @if (s.LimitedOffers.Count > 0)
            {
                <div class="tab-pane fade" id="eos-offers" role="tabpanel">
                    <p class="eos-best">@N(s.LimitedOffers.Sum(o => o.TimesOffered)) limited-time offers · @s.LimitedOffers.Count(o => o.Bought > 0) bought · @N(s.LimitedOffers.Sum(o => o.CrystalsSpent)) red crystals spent</p>
                    <table id="eos-offers-table" class="table table-sm table-striped eos-table w-100">
                        <thead><tr><th>Pack</th><th>First offered</th><th>Last offered</th><th class="num">Times offered</th><th class="num">Price (red crystals)</th><th class="num">Times bought</th><th class="num">Crystals spent</th></tr></thead>
                        <tbody>
                            @foreach (var o in s.LimitedOffers)
                            {
                                <tr><td>@o.Name</td><td data-order="@(o.FirstOffered?.Ticks ?? 0)">@(o.FirstOffered?.ToString("MMM d, yyyy") ?? "")</td><td data-order="@(o.LastOffered?.Ticks ?? 0)">@(o.LastOffered?.ToString("MMM d, yyyy") ?? "")</td><td class="num">@o.TimesOffered</td><td class="num">@(o.PriceCrystals > 0 ? N(o.PriceCrystals) : "")</td><td class="num">@(o.Bought > 0 ? N(o.Bought) : "")</td><td class="num">@(o.CrystalsSpent > 0 ? N(o.CrystalsSpent) : "")</td></tr>
                            }
                        </tbody>
                    </table>
                    <p class="text-muted small">These pop-up packs unlocked for a limited time after something happened in game, such as finishing an event, pulling a weapon or watching a character stream. The export records when each offer appeared. "Times bought" counts every purchase of that pack, including from other offers of the same pack.</p>
                </div>
            }

            <div class="tab-pane fade" id="eos-materia" role="tabpanel">
                <h2 class="h6 eos-section-title">Materia owned</h2>
                <p class="text-muted small mb-2">One row per materia. Sub stat columns sort highest first; percent stats are shown to one decimal as in game. Elemental potency names are read from the game data's stat codes.</p>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <label for="eos-materia-stat-filter" class="form-label mb-0 small">Has sub stat</label>
                    <select id="eos-materia-stat-filter" class="form-select form-select-sm w-auto">
                        <option value="">Any</option>
                        @for (var c = 0; c < s.MateriaStatColumns.Count; c++)
                        {
                            <option value="@(c + 4)">@s.MateriaStatColumns[c]</option>
                        }
                    </select>
                </div>
                <table id="eos-owned-materia-table" class="table table-sm table-striped eos-table w-100 mb-4 text-nowrap">
                    <thead><tr><th>Materia</th><th class="num">Stars</th><th>Locked</th><th>Obtained</th>@foreach (var col in s.MateriaStatColumns){<th class="num">@col</th>}</tr></thead>
                    <tbody>
                        @foreach (var x in s.MateriaOwned)
                        {
                            <tr>
                                <td>@x.Name</td>
                                <td class="num">@x.Stars★</td>
                                <td>@(x.Locked ? "🔒" : "")</td>
                                <td data-order="@(x.Obtained?.Ticks ?? 0)">@(x.Obtained?.ToString("MMM d, yyyy") ?? "")</td>
                                @foreach (var col in s.MateriaStatColumns)
                                {
                                    if (x.Stats.TryGetValue(col, out var v))
                                    {
                                        <td class="num" data-order="@v.ToString(System.Globalization.CultureInfo.InvariantCulture)">@(col.EndsWith("%") ? v.ToString("0.0") + "%" : N((long)v))</td>
                                    }
                                    else
                                    {
                                        <td class="num" data-order="-1"></td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                <h2 class="h6 eos-section-title">Crafting</h2>
                <div class="row g-4">
                    <div class="col-lg-4">
                        <table class="table table-sm eos-materia">
                            <thead><tr><th>Rarity</th><th>Crafted</th><th>Obtained</th></tr></thead>
                            <tbody>
                                @for (var q = 4; q >= 0; q--)
                                {
                                    <tr><td>@(q + 1)★</td><td>@N(s.Materia.CraftedByStar[q])</td><td>@N(s.Materia.ObtainedByStar[q])</td></tr>
                                }
                                <tr class="fw-bold"><td>Total</td><td>@N(s.Materia.TotalCrafted)</td><td>@N(s.Materia.TotalObtained)</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-lg-8">
                        <table id="eos-recipes-table" class="table table-sm table-striped eos-table w-100">
                            <thead><tr><th>Recipe</th><th class="num">Times crafted</th></tr></thead>
                            <tbody>
                                @foreach (var r in s.MateriaRecipes)
                                {
                                    <tr><td>@r.Name</td><td class="num">@N(r.TotalCrafted)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="eos-characters" role="tabpanel">
                <table class="table table-sm table-striped eos-table">
                    <thead><tr><th>Character</th><th class="num">Level</th><th class="num">Outfits</th><th class="num">Weapons</th><th class="num">Weapon pulls</th></tr></thead>
                    <tbody>
                        @foreach (var c in s.Characters)
                        {
                            <tr>
                                <td>@c.Name</td>
                                <td class="num">@c.Level <span class="text-muted">/ @c.MaxLevel</span></td>
                                <td class="num">@c.CostumesOwned <span class="text-muted">/ @c.CostumesTotal</span></td>
                                <td class="num">@c.WeaponsOwned <span class="text-muted">/ @c.WeaponsTotal</span></td>
                                <td class="num">@N(c.WeaponPulls)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="eos-parties" role="tabpanel">
                <p class="text-muted small">Saved party slots, strongest first. Combat power is the value the game showed for the party.</p>
                <table id="eos-parties-table" class="table table-sm table-striped eos-table w-100">
                    <thead><tr><th>Party</th><th class="num">Combat power</th><th>Members (main weapon · outfit)</th></tr></thead>
                    <tbody>
                        @foreach (var p in s.Parties)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td class="num">@N(p.CombatPower)</td>
                                <td>
                                    @foreach (var mbr in p.Members)
                                    {
                                        <div><strong>@mbr.Character</strong>@if (mbr.MainWeapon is not null) {<span class="text-muted"> · @mbr.MainWeapon</span>}@if (mbr.Outfit is not null) {<span class="text-muted"> · @mbr.Outfit</span>}</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="eos-memoria" role="tabpanel">
                <select id="eos-memoria-status" class="form-select form-select-sm w-auto mb-2" aria-label="Status"><option value="">All memoria</option><option value="Owned">Owned</option><option value="Collecting">Collecting</option><option value="Missing">Missing</option></select>
                <table id="eos-memoria-table" class="table table-sm table-striped eos-table w-100">
                    <thead><tr><th>Memoria</th><th class="num">Rarity</th><th>Status</th><th class="num">Level</th><th class="num">Fragments</th><th>Obtained</th><th>From</th></tr></thead>
                    <tbody>
                        @foreach (var x in s.Memoria)
                        {
                            <tr>
                                <td>@x.Name</td>
                                <td class="num" data-order="@x.Stars">@(new string('★', Math.Max(x.Stars, 0)))</td>
                                <td>@(x.Owned ? "Owned" : x.Fragments > 0 ? "Collecting" : "Missing")</td>
                                <td class="num" data-order="@(x.Level ?? 0)">@(x.Level is int ml ? $"{ml} / {x.MaxLevel}" : "–")</td>
                                <td class="num" data-order="@x.Fragments">@x.Fragments / @x.FragmentsNeeded</td>
                                <td data-order="@(x.Obtained?.Ticks ?? 0)">@(x.Obtained?.ToString("MMM d, yyyy") ?? "")</td>
                                <td>@(x.Source ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="text-muted small">Collecting means you have some fragments but not enough to use it yet.</p>
            </div>

            <div class="tab-pane fade" id="eos-skills" role="tabpanel">
                @if (s.GrowthBoards.Count > 0)
                {
                    <h2 class="h6 eos-section-title">Growth boards</h2>
                    <div class="d-flex gap-2">
                        <select id="eos-growth-type" class="form-select form-select-sm w-auto mb-2" aria-label="Board type"><option value="">All boards</option>
                            @foreach (var gt in s.GrowthBoards.Select(g => g.Type).Distinct().OrderBy(x => x))
                            {
                                <option value="@gt">@gt</option>
                            }
                        </select>
                    </div>
                    <table id="eos-growth-table" class="table table-sm table-striped eos-table w-100">
                        <thead><tr><th>Character / summon</th><th>Board</th><th class="num">Panels</th><th class="num">Nodes</th><th class="num">HP</th><th class="num">PATK</th><th class="num">MATK</th><th class="num">PDEF</th><th class="num">MDEF</th><th class="num">Heal</th></tr></thead>
                        <tbody>
                            @foreach (var g in s.GrowthBoards)
                            {
                                var gpct = g.NodesTotal > 0 ? g.NodesUnlocked * 100 / g.NodesTotal : 0;
                                <tr><td>@g.Name</td><td>@g.Type</td><td class="num">@g.Boards</td><td class="num" data-order="@g.NodesUnlocked">@N(g.NodesUnlocked) / @N(g.NodesTotal) (@gpct%)</td><td class="num">@(g.Hp > 0 ? N(g.Hp) : "")</td><td class="num">@(g.PhysicalAttack > 0 ? N(g.PhysicalAttack) : "")</td><td class="num">@(g.MagicalAttack > 0 ? N(g.MagicalAttack) : "")</td><td class="num">@(g.PhysicalDefense > 0 ? N(g.PhysicalDefense) : "")</td><td class="num">@(g.MagicalDefense > 0 ? N(g.MagicalDefense) : "")</td><td class="num">@(g.Healing > 0 ? N(g.Healing) : "")</td></tr>
                            }
                        </tbody>
                    </table>
                    <p class="text-muted small">Stat columns add up the flat stat nodes unlocked on each board. Summon and enemy-ability boards raise their skill's power and lower its cost instead, so they only show node counts.</p>
                    <h2 class="h6 eos-section-title mt-4">Skills</h2>
                }
                <div class="d-flex gap-2">
                    <select id="eos-skill-type" class="form-select form-select-sm w-auto mb-2" aria-label="Status"><option value="">All types</option><option value="Limit Break">Limit Breaks</option><option value="Summon">Summon skills</option><option value="Overaccel">Overaccel</option><option value="Other">Other</option></select>
                    <select id="eos-skill-status" class="form-select form-select-sm w-auto mb-2" aria-label="Status"><option value="">Owned and missing</option><option value="Owned">Owned</option><option value="Missing">Missing</option></select>
                </div>
                <table id="eos-skills-table" class="table table-sm table-striped eos-table w-100">
                    <thead><tr><th>Skill</th><th>Type</th><th>Character / summon</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var x in s.Skills)
                        {
                            <tr><td>@x.Name</td><td>@x.Type</td><td>@x.For</td><td>@(x.Owned ? "Owned" : "Missing")</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="eos-highwind" role="tabpanel">
                <div class="row g-4">
                    <div class="col-xl-6">
                        <h2 class="h6 eos-section-title">Highwind</h2>
                        <p class="eos-best">@N(s.Highwind.IdleCollections) idle collections · @s.Highwind.KeyItems.Count / @s.Highwind.KeyItemsTotal key items · @N(s.TotalHighwindCactuars + s.TotalHighwindGoldCactuars + s.TotalHighwindGoldBombs) treasure battle wins@(s.PaintCans is long pc ? $" · {N(pc)} Paint Cans left" : "")</p>
                        @foreach (var p in s.Highwind.Parts)
                        {
                            var hpct = (int)Math.Min(100, p.Value * 100 / 120);
                            <div class="eos-progress-row">
                                <span>@p.Name</span>
                                <div class="eos-bar" role="progressbar" aria-label="@p.Name" aria-valuenow="@hpct" aria-valuemin="0" aria-valuemax="100"><div style="width: @hpct%"></div></div>
                                <span class="eos-progress-num">Lv @p.Value</span>
                            </div>
                        }
                        <table id="eos-keyitems-table" class="table table-sm table-striped eos-table w-100 mt-3">
                            <thead><tr><th>Key item</th><th class="num">Upgrades</th><th>Obtained</th></tr></thead>
                            <tbody>
                                @foreach (var k in s.Highwind.KeyItems)
                                {
                                    <tr>
                                        <td>@k.Name</td>
                                        <td class="num" data-order="@k.Upgrades">@k.Upgrades@(k.MaxUpgrades > 0 ? " / " + k.MaxUpgrades : "")</td>
                                        <td data-order="@(k.Obtained?.Ticks ?? 0)">@(k.Obtained?.ToString("MMM d, yyyy") ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="text-muted small">Part levels are shown out of 120, the highest level in this export.</p>
                    </div>
                    <div class="col-xl-6">
                        <h2 class="h6 eos-section-title">Guild</h2>
                        <dl class="row small mb-3">
                            @if (!string.IsNullOrEmpty(s.GuildName)) { <dt class="col-5">Current guild</dt><dd class="col-7">@s.GuildName</dd> }
                            @if (s.GuildLevel is int gl) { <dt class="col-5">Guild level</dt><dd class="col-7">@gl</dd> }
                            @if (s.Guild.Created is DateTime gc) { <dt class="col-5">Guild founded</dt><dd class="col-7">@gc.ToString("MMM d, yyyy")</dd> }
                            @if (s.GuildJoined is DateTime gj) { <dt class="col-5">You joined</dt><dd class="col-7">@gj.ToString("MMM d, yyyy")</dd> }
                            <dt class="col-5">Times you left a guild</dt><dd class="col-7">@s.Guild.TimesLeftAGuild</dd>
                            <dt class="col-5">Guild battles fought</dt><dd class="col-7">@s.GuildBattles.Count</dd>
                        </dl>
                        @if (s.Guild.Bonuses.Count > 0)
                        {
                            <h3 class="h6">Your guild bonuses</h3>
                            @foreach (var b in s.Guild.Bonuses)
                            {
                                var max = s.Guild.BonusMax.GetValueOrDefault(b.Name);
                                var bpct = max > 0 ? (int)Math.Min(100, b.Value * 100 / max) : 0;
                                <div class="eos-progress-row">
                                    <span>@b.Name</span>
                                    <div class="eos-bar" role="progressbar" aria-label="@b.Name" aria-valuenow="@bpct" aria-valuemin="0" aria-valuemax="100"><div style="width: @bpct%"></div></div>
                                    <span class="eos-progress-num">Lv @b.Value@(max > 0 ? " / " + max : "")</span>
                                </div>
                            }
                        }
                        @if (s.Guild.Achievements.Count > 0)
                        {
                            <h3 class="h6 mt-3">Current guild achievements</h3>
                            <table class="table table-sm table-striped eos-table">
                                <thead><tr><th>Achievement</th><th class="num">Progress</th></tr></thead>
                                <tbody>
                                    @foreach (var a in s.Guild.Achievements)
                                    {
                                        <tr>
                                            <td>@a.Description @if (a.Complete) {<span class="badge text-bg-success ms-1">Done</span>}</td>
                                            <td class="num">@N(Math.Min(a.Progress, a.Goal)) / @N(a.Goal)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <p class="text-muted small">Achievements belong to the guild, so they cover time before you joined.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="eos-missions" role="tabpanel">
                <p class="text-muted small">One-time and event missions you have progress on. Daily and weekly missions reset, so they are left out.</p>
                <div class="d-flex gap-2">
                    <select id="eos-mission-category" class="form-select form-select-sm w-auto mb-2" aria-label="Category">
                        <option value="">All categories</option>
                        @foreach (var c in s.Missions.Select(x => x.Category).Distinct().OrderBy(c => c))
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                    <select id="eos-mission-status" class="form-select form-select-sm w-auto mb-2" aria-label="Status"><option value="">Any status</option><option value="Complete">Complete</option><option value="In progress">In progress</option></select>
                </div>
                <table id="eos-missions-table" class="table table-sm table-striped eos-table w-100">
                    <thead><tr><th>Category</th><th>Mission</th><th class="num">Progress</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var x in s.Missions)
                        {
                            <tr><td>@x.Category</td><td>@x.Mission</td><td class="num" data-order="@x.Progress">@N(x.Progress) / @N(x.Goal)</td><td>@(x.Complete ? "Complete" : "In progress")</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="eos-chocobos" role="tabpanel">
                @if (s.ChocoboExpeditions.Count > 0)
                {
                    <div class="eos-cards">
                        <div class="eos-card eos-card-wide">
                            <h3>Expeditions in progress</h3>
                            <dl>
                                @foreach (var ex in s.ChocoboExpeditions)
                                {
                                    <dt>@ex.Area@(ex.Character is null ? "" : " · " + ex.Character)</dt><dd>@(ex.Started?.ToString("MMM d, yyyy") ?? "")</dd>
                                }
                            </dl>
                        </div>
                    </div>
                }
                <table id="eos-chocobos-table" class="table table-sm table-striped eos-table w-100">
                    <thead><tr><th class="num">Rarity</th><th class="num">Rank</th><th class="num">Rank cap</th><th class="num">Speed</th><th class="num">Stamina</th><th class="num">Intelligence</th><th class="num">Adaptability</th><th>Obtained</th><th>Locked</th></tr></thead>
                    <tbody>
                        @foreach (var c in s.Chocobos)
                        {
                            <tr>
                                <td class="num" data-order="@c.Rarity">@(c.Rarity > 0 ? c.Rarity + "★" : "–")</td>
                                <td class="num">@c.Rank</td>
                                <td class="num">@c.RankLimit</td>
                                <td class="num">@c.Balance[0]%</td>
                                <td class="num">@c.Balance[1]%</td>
                                <td class="num">@c.Balance[2]%</td>
                                <td class="num">@c.Balance[3]%</td>
                                <td data-order="@(c.Obtained?.Ticks ?? 0)">@(c.Obtained?.ToString("MMM d, yyyy") ?? "")</td>
                                <td>@(c.Locked ? "Yes" : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="text-muted small">Stat columns show each chocobo's stat balance (how its growth is split), not raw values.</p>
            </div>

            <div class="tab-pane fade" id="eos-passes" role="tabpanel">
                <div class="row g-4">
                    <div class="col-xl-8">
                        <h2 class="h6 eos-section-title">Season passes</h2>
                        <p class="eos-best">@s.SeasonPasses.Count passes · @s.SeasonPasses.Count(p => p.HasPremium) with the premium track</p>
                        <table id="eos-passes-table" class="table table-sm table-striped eos-table w-100">
                            <thead><tr><th>Pass</th><th>Ended</th><th class="num">Free rewards</th><th class="num">Premium rewards</th></tr></thead>
                            <tbody>
                                @foreach (var p in s.SeasonPasses)
                                {
                                    <tr>
                                        <td>@p.Name</td>
                                        <td data-order="@(p.Ended?.Ticks ?? 0)">@(p.Ended?.ToString("MMM d, yyyy") ?? "")</td>
                                        <td class="num">@p.FreeClaimed <span class="text-muted">/ @p.Steps</span></td>
                                        <td class="num">@(p.HasPremium ? $"{p.PremiumClaimed} / {p.Steps}" : "Not bought")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-xl-4">
                        @if (s.Logins.DaysLoggedIn > 0)
                        {
                            <h2 class="h6 eos-section-title">Logins</h2>
                            <div class="eos-card mb-4">
                                <div class="eos-big">@N(s.Logins.DaysLoggedIn) <small class="text-muted fs-6">days logged in</small></div>
                                <dl>
                                    @if (s.Logins.DaysAvailable > 0) {<dt>Days since account created</dt><dd>@N(s.Logins.DaysAvailable) (@(s.Logins.DaysLoggedIn * 100 / s.Logins.DaysAvailable)%)</dd><dt>Days missed</dt><dd>@N(Math.Max(0, s.Logins.DaysAvailable - s.Logins.DaysLoggedIn))</dd>}
                                    @if (s.Logins.LastLogin is DateTime ll) {<dt>Last daily login</dt><dd>@ll.ToString("MMM d, yyyy")</dd>}
                                    <dt>Login campaigns</dt><dd>@N(s.Logins.Campaigns) (@N(s.Logins.CampaignLogins) claims)</dd>
                                </dl>
                            </div>
                        }
                        <h2 class="h6 eos-section-title">Steam achievements</h2>
                        <div class="eos-card">
                            <div class="eos-big">@s.Achievements.Unlocked <small class="text-muted fs-6">/ @s.Achievements.Total unlocked</small></div>
                            <dl>
                                @if (s.Achievements.First is DateTime first) {<dt>First unlocked</dt><dd>@first.ToString("MMM d, yyyy")</dd>}
                                @if (s.Achievements.Latest is DateTime latest) {<dt>Latest unlocked</dt><dd>@latest.ToString("MMM d, yyyy")</dd>}
                                @foreach (var y in s.Achievements.ByYear)
                                {
                                    <dt>Unlocked in @y.Name</dt><dd>@y.Value</dd>
                                }
                            </dl>
                        </div>
                        <p class="text-muted small mt-2">The export only has unlock dates; the game data doesn't include achievement names.</p>
                    </div>
                </div>
            </div>

            @if (s.Purchases is { } pur)
            {
                <div class="tab-pane fade" id="eos-purchases" role="tabpanel">
                    <div class="eos-cards">
                        <div class="eos-card">
                            <h3>Paid packs</h3>
                            <div class="eos-big">@N(pur.TotalPacks)</div>
                            <dl>
                                <dt>List price (USD)</dt><dd>$@pur.TotalListPriceUsd.ToString("N2")</dd>
                                <dt>Crystals included</dt><dd>@N(pur.TotalCrystals)</dd>
                            </dl>
                        </div>
                        <div class="eos-card">
                            <h3>Shop exchanges</h3>
                            <div class="eos-big">@N(pur.Shops.Sum(x => x.TotalPurchases))</div>
                            <dl>
                                <dt>Shops used</dt><dd>@N(pur.Shops.Count)</dd>
                                <dt>Different items</dt><dd>@N(pur.Shops.Sum(x => x.ItemsBought))</dd>
                            </dl>
                        </div>
                    </div>
                    <p class="text-muted small">Prices are the game's US list prices; what you actually paid can differ by region, store and sales.</p>
                    <div class="row g-4">
                        <div class="col-xl-7">
                            <h2 class="h6 eos-section-title">Paid packs</h2>
                            <table id="eos-paid-table" class="table table-sm table-striped eos-table w-100">
                                <thead><tr><th>Pack</th><th>Shop</th><th class="num">Bought</th><th class="num">Price (USD)</th><th class="num">Crystals</th><th>Last bought</th></tr></thead>
                                <tbody>
                                    @foreach (var p in pur.Paid)
                                    {
                                        <tr>
                                            <td>@p.Name</td>
                                            <td>@p.Shop</td>
                                            <td class="num">@N(p.Count)</td>
                                            <td class="num">@p.PriceUsd.ToString("N2")</td>
                                            <td class="num">@N(p.Crystals)</td>
                                            <td data-order="@(p.LastPurchased?.Ticks ?? 0)">@(p.LastPurchased?.ToString("MMM d, yyyy") ?? "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="col-xl-5">
                            <h2 class="h6 eos-section-title">Shop exchanges</h2>
                            <table id="eos-shops-table" class="table table-sm table-striped eos-table w-100">
                                <thead><tr><th>Shop</th><th class="num">Items</th><th class="num">Purchases</th><th>Last</th></tr></thead>
                                <tbody>
                                    @foreach (var x in pur.Shops)
                                    {
                                        <tr>
                                            <td>@x.Name</td>
                                            <td class="num">@N(x.ItemsBought)</td>
                                            <td class="num">@N(x.TotalPurchases)</td>
                                            <td data-order="@(x.LastPurchased?.Ticks ?? 0)">@(x.LastPurchased?.ToString("MMM yyyy") ?? "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div class="tab-pane fade" id="eos-battles" role="tabpanel">
                <div class="row g-4">
                    <div class="col-xl-5">
                        <h2 class="h6 eos-section-title">Wins by mode</h2>
                        <table class="table table-sm table-striped eos-table">
                            <thead><tr><th>Mode</th><th></th><th class="num">Battles won</th><th class="num">Wins</th></tr></thead>
                            <tbody>
                                @foreach (var x in s.Battles.ByMode)
                                {
                                    <tr><td>@x.Name</td><td>@(x.Coop ? "Co-op" : "Solo")</td><td class="num">@N(x.Battles)</td><td class="num">@N(x.Wins)</td></tr>
                                }
                            </tbody>
                            <tfoot><tr class="fw-semibold"><td>Total</td><td></td><td></td><td class="num">@N(s.Battles.TotalWins)</td></tr></tfoot>
                        </table>
                        <p class="text-muted small">Battles won counts different battles with at least one win. Crash battles, Crisis stages and Damage Ranking stages are event battles, so they're already in the event rows. Story battles (@N(s.Battles.StoryBattlesCleared) cleared) only record a clear, not a win count. The game doesn't keep dates per battle, so wins can't be split by year. Tower, dungeon and other counters are on <a href="#" onclick="document.querySelector('[data-bs-target=&quot;#eos-records&quot;]').click(); return false;">Play records</a>.</p>

                        <h2 class="h6 eos-section-title mt-4">Most-played battles</h2>
                        <table id="eos-topbattles-table" class="table table-sm table-striped eos-table w-100">
                            <thead><tr><th>Battle</th><th>Event / area</th><th>Mode</th><th class="num">Wins</th><th class="num">High score</th></tr></thead>
                            <tbody>
                                @foreach (var x in s.Battles.TopBattles)
                                {
                                    <tr><td>@x.Name</td><td>@x.Source</td><td>@(x.Coop ? "Co-op" : "Solo")</td><td class="num">@N(x.Wins)</td><td class="num" data-order="@x.HighScore">@(x.HighScore > 0 ? N(x.HighScore) : "–")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-xl-7">
                        <h2 class="h6 eos-section-title">Wins per event</h2>
                        <table id="eos-eventwins-table" class="table table-sm table-striped eos-table w-100">
                            <thead><tr><th>Event</th><th class="num">Solo</th><th class="num">Co-op</th><th class="num">Total</th><th class="num">Battles won</th></tr></thead>
                            <tbody>
                                @foreach (var x in s.Battles.Events)
                                {
                                    <tr><td>@x.Name</td><td class="num">@N(x.SoloWins)</td><td class="num">@N(x.CoopWins)</td><td class="num">@N(x.TotalWins)</td><td class="num">@N(x.Battles)</td></tr>
                                }
                            </tbody>
                        </table>

                        <h2 class="h6 eos-section-title mt-4">Areas and co-op bosses</h2>
                        <table id="eos-areawins-table" class="table table-sm table-striped eos-table w-100">
                            <thead><tr><th>Area / boss</th><th>Type</th><th class="num">Battles won</th><th class="num">Wins</th><th class="num">High score</th></tr></thead>
                            <tbody>
                                @foreach (var x in s.Battles.Areas)
                                {
                                    <tr><td>@x.Name</td><td>@x.Category</td><td class="num">@N(x.Battles)</td><td class="num">@N(x.Wins)</td><td class="num" data-order="@x.HighScore">@(x.HighScore > 0 ? N(x.HighScore) : "–")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="eos-records" role="tabpanel">
                <div class="eos-cards">
                    @foreach (var g in s.RecordGroups)
                    {
                        <div class="eos-card">
                            <h3>@g.Name</h3>
                            <dl>
                                @foreach (var r in g.Records)
                                {
                                    <dt>@r.Name</dt><dd>@(r.IsMaxed ? "Max" : N(r.Value))</dd>
                                }
                            </dl>
                        </div>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="eos-rankings" role="tabpanel">
                <p class="text-muted small mb-3"><i class="fas fa-medal eos-badge-icon ms-0"></i> marks a placement that earned a badge.</p>
                <div class="row g-4">
                    <div class="col-xl-6">
                        <h2 class="h6 eos-section-title">Battle Rankings (Crisis Events)</h2>
                        @RankSummary(s.CrisisEvents, 20)
                        <table class="table table-sm table-striped eos-table" id="eos-crisis-table">
                            <thead><tr><th>Event</th><th>Ended</th><th class="num">Final rank</th><th class="num">Points</th><th class="num">Best stage</th></tr></thead>
                            <tbody>
                                @foreach (var e in s.CrisisEvents)
                                {
                                    var detailId = AddDetail(e.Stages.Count > 0 ? StageTable(e.Stages, false) : null);
                                    <tr>
                                        <td>@e.Name @if (e.Stages.Count > 0) {<button type="button" class="btn btn-link btn-sm p-0 ms-1 eos-detail" data-template="eos-d-@(detailId)" data-title="@e.Name">stages</button>}</td>
                                        <td data-order="@(e.EndDate?.Ticks ?? 0)">@(e.EndDate?.ToString("MMM yyyy") ?? "")</td>
                                        <td class="num" data-order="@(e.FinalRank > 0 ? e.FinalRank : int.MaxValue)">@Rank(e)</td>
                                        <td class="num">@N(e.Points)</td>
                                        <td class="num">@(e.HighStage > 0 ? N(e.HighStage) : "–")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-xl-6">
                        <h2 class="h6 eos-section-title">Guild Battles</h2>
                        @RankSummary(s.GuildBattles, 10)
                        <table class="table table-sm table-striped eos-table" id="eos-guild-table">
                            <thead><tr><th>Battle</th><th>Ended</th><th class="num">Your guild's rank</th>@if (!string.IsNullOrEmpty(s.GuildName)) {<th class="num">@s.GuildName's rank</th>}</tr></thead>
                            <tbody>
                                @foreach (var e in s.GuildBattles)
                                {
                                    var detailId = AddDetail(e.Fights.Count > 0 ? FightTable(e.Fights) : null);
                                    <tr>
                                        <td>@e.Name @if (e.Fights.Count > 0) {<button type="button" class="btn btn-link btn-sm p-0 ms-1 eos-detail" data-template="eos-d-@(detailId)" data-title="@e.Name">bosses</button>}</td>
                                        <td data-order="@(e.EndDate?.Ticks ?? 0)">@(e.EndDate?.ToString("MMM yyyy") ?? "")</td>
                                        <td class="num" data-order="@(e.FinalRank > 0 ? e.FinalRank : int.MaxValue)">@Rank(e)</td>
                                        @if (!string.IsNullOrEmpty(s.GuildName))
                                        {
                                            <td class="num" data-order="@(e.CurrentGuildRank ?? int.MaxValue)">@(e.CurrentGuildRank is int cr ? "#" + N(cr) : "–")</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="text-muted small">"Your guild's rank" is the guild you were in for that battle.</p>
                    </div>
                    <div class="col-xl-6">
                        <h2 class="h6 eos-section-title">Damage Rankings</h2>
                        @RankSummary(s.DamageRankings, 20)
                        <table class="table table-sm table-striped eos-table">
                            <thead><tr><th>Event</th><th>Ended</th><th class="num">Final rank</th><th class="num">Best damage</th><th>Latest best team</th></tr></thead>
                            <tbody>
                                @foreach (var e in s.DamageRankings)
                                {
                                    var detailId = AddDetail(e.Stages.Count > 0 ? StageTable(e.Stages, true) : null);
                                    <tr>
                                        <td>@e.Name @if (e.Stages.Count > 0) {<button type="button" class="btn btn-link btn-sm p-0 ms-1 eos-detail" data-template="eos-d-@(detailId)" data-title="@e.Name">stages</button>}</td>
                                        <td>@(e.EndDate?.ToString("MMM yyyy") ?? "")</td>
                                        <td class="num">@Rank(e)</td>
                                        <td class="num">@(e.BestDamage > 0 ? N(e.BestDamage) : "–")</td>
                                        <td>@(e.BestTeam ?? "–")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="col-xl-6">
                        <h2 class="h6 eos-section-title">Dungeon Rankings</h2>
                        @RankSummary(s.ScoreDungeons, 20)
                        <table class="table table-sm table-striped eos-table">
                            <thead><tr><th>Dungeon</th><th>Ended</th><th class="num">Final rank</th></tr></thead>
                            <tbody>
                                @foreach (var e in s.ScoreDungeons)
                                {
                                    <tr>
                                        <td>@e.Name</td>
                                        <td>@(e.EndDate?.ToString("MMM yyyy") ?? "")</td>
                                        <td class="num">@Rank(e)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="eos-badges" role="tabpanel">
                @if (s.Badges.Count == 0)
                {
                    <p class="text-muted">No badges in this export.</p>
                }
                <div class="eos-cards">
                    @foreach (var b in s.Badges)
                    {
                        <div class="eos-card eos-badge-card @(b.EarnedFrom.Count > 0 ? "eos-card-wide" : "")">
                            <h3><i class="fas fa-medal eos-badge-icon ms-0 me-1"></i>@b.Name</h3>
                            <div class="eos-big">@N(b.Count) <small>earned</small></div>
                            <p>@b.Description</p>
                            @if (b.EarnedFrom.Count > 0)
                            {
                                <ul>
                                    @foreach (var e in b.EarnedFrom)
                                    {
                                        <li>@e</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="tab-pane fade" id="eos-challenges" role="tabpanel">
                <div class="row g-4">
                    <div class="col-xl-7">
                        <h2 class="h6 eos-section-title">Max. Damage Challenge</h2>
                        <table class="table table-sm table-striped eos-table">
                            <thead><tr><th>Challenge</th><th class="num">High score</th><th class="num">Attempts</th><th>Last improved</th></tr></thead>
                            <tbody>
                                @foreach (var d in s.DamageChallenges)
                                {
                                    <tr>
                                        <td>@d.Name</td>
                                        <td class="num">@N(d.HighScore)@if (d.IsMaxed) {<span class="badge text-bg-warning ms-1">Max</span>}</td>
                                        <td class="num">@N(d.Attempts)</td>
                                        <td>@(d.LastImproved?.ToString("MMM d, yyyy") ?? "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (s.DamageChallenges.Any(d => d.IsMaxed))
                        {
                            <p class="text-muted small">Max is the highest score the game can record.</p>
                        }
                        @if (s.CriterionDungeons.Count > 0)
                        {
                            <h2 class="h6 eos-section-title mt-4">Criterion Dungeons</h2>
                            <p class="eos-best">@s.CriterionDungeons.Count dungeons cleared · @s.CriterionDungeons.Count(d => d.BestRank == "SS") at SS</p>
                            <table id="eos-criterion-table" class="table table-sm table-striped eos-table w-100">
                                <thead><tr><th>Dungeon</th><th class="num">Difficulty</th><th class="num">Best rank</th><th class="num">High score</th><th class="num">Clears</th><th>Team</th><th>Last improved</th></tr></thead>
                                <tbody>
                                    @foreach (var d in s.CriterionDungeons)
                                    {
                                        var detailId = AddDetail(d.Battles.Count > 0 ? BattleTable(d.Battles) : null);
                                        <tr>
                                            <td>@d.Name @if (d.Battles.Count > 0) {<button type="button" class="btn btn-link btn-sm p-0 ms-1 eos-detail" data-template="eos-d-@(detailId)" data-title="@d.Name (difficulty @d.Difficulty)">battles</button>}</td>
                                            <td class="num">@d.Difficulty</td>
                                            <td class="num" data-order="@d.RankOrder">@d.BestRank</td>
                                            <td class="num">@N(d.HighScore)</td>
                                            <td class="num">@N(d.Clears)</td>
                                            <td>@(d.Team ?? "–")</td>
                                            <td data-order="@(d.LastImproved?.Ticks ?? 0)">@(d.LastImproved?.ToString("MMM d, yyyy") ?? "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        @if (s.CrashBattles.Count > 0)
                        {
                            <h2 class="h6 eos-section-title mt-4">Crash Battles</h2>
                            <p class="eos-best">Solo @s.CrashBattles.Count(c => !c.Coop && c.Cleared) / @s.CrashBattles.Count(c => !c.Coop) cleared · Co-op @s.CrashBattles.Count(c => c.Coop && c.Cleared) / @s.CrashBattles.Count(c => c.Coop) cleared</p>
                            <div class="d-flex gap-2 mb-2">
                                <select id="eos-crash-mode" class="form-select form-select-sm w-auto" aria-label="Mode">
                                    <option value="">Solo and co-op</option>
                                    <option value="Solo">Solo</option>
                                    <option value="Co-op">Co-op</option>
                                </select>
                                <select id="eos-crash-status" class="form-select form-select-sm w-auto" aria-label="Status">
                                    <option value="">Any status</option>
                                    <option value="Cleared">Cleared</option>
                                    <option value="Not cleared">Not cleared</option>
                                    <option value="Not attempted">Not attempted</option>
                                </select>
                            </div>
                            <table id="eos-crash-table" class="table table-sm table-striped eos-table w-100">
                                <thead><tr><th>Battle</th><th>Mode</th><th>Status</th><th class="num">Clears</th><th class="num">High score</th></tr></thead>
                                <tbody>
                                    @foreach (var c in s.CrashBattles)
                                    {
                                        <tr>
                                            <td>@c.Name</td>
                                            <td>@(c.Coop ? "Co-op" : "Solo")</td>
                                            <td>@(c.Cleared ? "Cleared" : c.Attempted ? "Not cleared" : "Not attempted")</td>
                                            <td class="num">@N(c.Wins)</td>
                                            <td class="num">@(c.HighScore > 0 ? N(c.HighScore) : "–")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <p class="text-muted small mb-0">The battles that count toward the Crash Battle badges.</p>
                        }
                    </div>
                    <div class="col-xl-5">
                        @if (s.EscalationChallenges.Count > 0)
                        {
                            <h2 class="h6 eos-section-title">Escalation Challenges</h2>
                            @foreach (var t in s.EscalationChallenges)
                            {
                                var epct = t.Total > 0 ? (int)(100.0 * Math.Min(t.Cleared, t.Total) / t.Total) : 0;
                                <div class="eos-progress-row">
                                    <span>@t.Name</span>
                                    <div class="eos-bar" role="progressbar" aria-label="@t.Name" aria-valuenow="@epct" aria-valuemin="0" aria-valuemax="100"><div style="width: @epct%"></div></div>
                                    <span class="eos-progress-num">Lv @t.Cleared@(t.Total > 0 ? " / " + t.Total : "")</span>
                                </div>
                            }
                            <div class="mb-4"></div>
                        }
                        <h2 class="h6 eos-section-title">Battle Towers</h2>
                        @foreach (var t in s.Towers)
                        {
                            var pct = t.Total > 0 ? (int)(100.0 * Math.Min(t.Cleared, t.Total) / t.Total) : 0;
                            <div class="eos-progress-row">
                                <span>@t.Name</span>
                                <div class="eos-bar" role="progressbar" aria-label="@t.Name" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"><div style="width: @pct%"></div></div>
                                <span class="eos-progress-num">@t.Cleared / @t.Total</span>
                            </div>
                        }
                        @if (s.SingularityTowers.Count > 0)
                        {
                            <h2 class="h6 eos-section-title mt-4">Battle Tower: Singularity</h2>
                            @foreach (var t in s.SingularityTowers)
                            {
                                var spct = t.Total > 0 ? (int)(100.0 * Math.Min(t.Cleared, t.Total) / t.Total) : 0;
                                <div class="eos-progress-row">
                                    <span>@t.Name</span>
                                    <div class="eos-bar" role="progressbar" aria-label="@t.Name" aria-valuenow="@spct" aria-valuemin="0" aria-valuemax="100"><div style="width: @spct%"></div></div>
                                    <span class="eos-progress-num">@t.Cleared / @t.Total</span>
                                </div>
                            }
                            <p class="text-muted small">Limited-time towers. Floors cleared are floors the player has won at least once.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
        @for (var i = 0; i < details.Count; i++)
        {
            <template id="eos-d-@i">@details[i]</template>
        }
        <div class="modal fade" id="eos-detail-modal" tabindex="-1" aria-labelledby="eos-detail-title" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h6" id="eos-detail-title"></h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body"></div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            if (typeof DataTable === 'undefined' || !document.getElementById('eos-draws-table')) return;
            // Formatted numbers ("1,234") sort as numbers via the num-fmt type.
            const opts = (order) => ({ pageLength: 25, order: order, columnDefs: [{ targets: 'num', type: 'num-fmt' }] });
            const draws = new DataTable('#eos-draws-table', opts([[3, 'desc']]));
            const weapons = new DataTable('#eos-weapons-table', opts([[7, 'desc']]));
            const outfits = new DataTable('#eos-outfits-table', Object.assign(opts([]), { ordering: true }));
            const statusFilter = (selId, table) => document.getElementById(selId).addEventListener('change', function () {
                table.column(2).search(this.value ? '^' + this.value + '$' : '', { regex: true, smart: false }).draw();
            });
            statusFilter('eos-weapon-status', weapons);
            statusFilter('eos-outfit-status', outfits);
            new DataTable('#eos-items-table', opts([[2, 'desc']]));
            const shopTable = document.getElementById('eos-shop-table') ? new DataTable('#eos-shop-table', opts([[3, 'desc']])) : null;
            new DataTable('#eos-recipes-table', opts([[1, 'desc']]));
            const small = (order) => Object.assign(opts(order), { pageLength: 10, lengthChange: false });
            new DataTable('#eos-crisis-table', small([[1, 'desc']]));
            new DataTable('#eos-guild-table', small([[1, 'desc']]));
            const t = (id, order, o) => { if (document.getElementById(id)) new DataTable('#' + id, Object.assign(opts(order), o || {})); };
            const matEl = document.getElementById('eos-owned-materia-table');
            if (matEl) {
                const mat = new DataTable(matEl, Object.assign(opts([[1, 'desc'], [0, 'asc']]), { scrollX: true, columnDefs: [{ targets: 'num', type: 'num' }] }));
                const pick = document.getElementById('eos-materia-stat-filter');
                let statCol = null;
                DataTable.ext.search.push((settings, data, idx) => {
                    if (settings.nTable !== matEl || statCol === null) return true;
                    return mat.cell(idx, statCol).node().getAttribute('data-order') !== '-1';
                });
                pick.addEventListener('change', () => {
                    statCol = pick.value === '' ? null : parseInt(pick.value, 10);
                    if (statCol !== null) mat.order([statCol, 'desc']);
                    mat.draw();
                });
                // scrollX tables need a resize when their tab becomes visible.
                document.querySelector('[data-bs-target="#eos-materia"]')?.addEventListener('shown.bs.tab', () => mat.columns.adjust());
            }
            t('eos-parties-table', [[1, 'desc']]);
            t('eos-chocobos-table', [[1, 'desc'], [0, 'desc']]);
            t('eos-passes-table', [[1, 'desc']], { pageLength: 10, lengthChange: false });
            t('eos-criterion-table', [[6, 'desc']], { pageLength: 10, lengthChange: false });
            // Exact-match column filters for the owned/missing style selects.
            const filterOn = (table, selId, col) => document.getElementById(selId)?.addEventListener('change', function () {
                table.column(col).search(this.value ? '^' + DataTable.util.escapeRegex(this.value) + '$' : '', { regex: true, smart: false }).draw();
            });
            t('eos-offers-table', [[1, 'desc']]);
            t('eos-wish-table', [[1, 'desc']], { pageLength: 10, lengthChange: false });
            t('eos-box-table', [[2, 'desc']], { pageLength: 10, lengthChange: false });
            t('eos-topbattles-table', [[3, 'desc']], { pageLength: 25, lengthChange: false, paging: false, searching: false });
            t('eos-eventwins-table', [[3, 'desc']], { pageLength: 15, lengthChange: false });
            t('eos-areawins-table', [[3, 'desc']], { pageLength: 15, lengthChange: false });
            const memoria = new DataTable('#eos-memoria-table', opts([[2, 'desc'], [1, 'desc']]));
            filterOn(memoria, 'eos-memoria-status', 2);
            const growthEl = document.getElementById('eos-growth-table');
            if (growthEl) filterOn(new DataTable(growthEl, Object.assign(opts([[1, 'asc'], [3, 'desc']]), { pageLength: 10 })), 'eos-growth-type', 1);
            if (shopTable) filterOn(shopTable, 'eos-shop-filter', 1);
            const skills = new DataTable('#eos-skills-table', Object.assign(opts([]), { ordering: true }));
            filterOn(skills, 'eos-skill-type', 1);
            filterOn(skills, 'eos-skill-status', 3);
            t('eos-keyitems-table', [[2, 'asc']], { pageLength: 10, lengthChange: false });
            const missions = new DataTable('#eos-missions-table', opts([[0, 'asc']]));
            filterOn(missions, 'eos-mission-category', 0);
            filterOn(missions, 'eos-mission-status', 3);
            const crashEl = document.getElementById('eos-crash-table');
            if (crashEl) {
                const crash = new DataTable(crashEl, Object.assign(opts([]), { ordering: true, pageLength: 10, lengthChange: false }));
                const colFilter = (selId, col) => document.getElementById(selId).addEventListener('change', function () {
                    crash.column(col).search(this.value ? '^' + this.value + '$' : '', { regex: true, smart: false }).draw();
                });
                colFilter('eos-crash-mode', 1);
                colFilter('eos-crash-status', 2);
            }
            // Detail buttons copy a hidden template into the shared modal. Delegated so paged-in rows work.
            const detailModal = document.getElementById('eos-detail-modal');
            document.addEventListener('click', e => {
                const b = e.target.closest('.eos-detail');
                if (!b) return;
                const tpl = document.getElementById(b.dataset.template);
                if (!tpl) return;
                detailModal.querySelector('.modal-title').textContent = b.dataset.title;
                const body = detailModal.querySelector('.modal-body');
                body.replaceChildren(tpl.content.cloneNode(true));
                bootstrap.Modal.getOrCreateInstance(detailModal).show();
            });
            t('eos-paid-table', [[5, 'desc']]);
            t('eos-shops-table', [[3, 'desc']]);
            document.getElementById('eos-draw-type').addEventListener('change', function () {
                const v = this.value;
                draws.column(1).search(v ? '^' + v + '$' : '', { regex: true, smart: false }).draw();
            });
            // Phones: plain (non-DataTables) tables scroll inside their own box instead of widening the page.
            document.querySelectorAll('.eos-tab-body table:not(.dataTable)').forEach(tb => {
                if (tb.closest('.table-responsive, .eos-scroll, .dt-container')) return;
                const wrap = document.createElement('div');
                wrap.className = 'eos-scroll';
                tb.parentNode.insertBefore(wrap, tb);
                wrap.appendChild(tb);
            });
            // Phones: a dropdown replaces the 20-tab strip.
            const tabSelect = document.querySelector('.eos-tab-select');
            const tabButtons = [...document.querySelectorAll('.eos-tabs button')];
            tabButtons.forEach((b, i) => tabSelect.add(new Option(b.textContent.trim(), i, false, b.classList.contains('active'))));
            tabSelect.addEventListener('change', () => bootstrap.Tab.getOrCreateInstance(tabButtons[tabSelect.value]).show());
            tabButtons.forEach((b, i) => b.addEventListener('shown.bs.tab', () => { tabSelect.value = i; }));
            // Tables inside hidden tabs need a width recalc once shown.
            document.querySelectorAll('.eos-tabs button').forEach(b => b.addEventListener('shown.bs.tab', () => DataTable.tables({ visible: true, api: true }).columns.adjust()));
        })();

        // Shareable summary (image drawn on a canvas + Discord-friendly text).
        (function () {
            const dataEl = document.getElementById('eos-share-data');
            const btn = document.getElementById('eos-share-btn');
            if (!dataEl || !btn) return;
            const d = JSON.parse(dataEl.textContent);
            const status = document.getElementById('eos-share-status');
            const say = (m) => { status.textContent = m; setTimeout(() => { if (status.textContent === m) status.textContent = ''; }, 3000); };
            const fileName = 'eos-stats-' + (d.name.replace(/[^a-z0-9]+/gi, '-').toLowerCase() || 'player') + '.png';

            const text = () => {
                const head = [
                    '**' + d.name + '**' + (d.guild ? ' · ' + d.guild : '') + (d.rank ? ' · Rank ' + d.rank : ''),
                    d.since ? 'Playing since ' + d.since + (d.days != null ? ' (' + d.days.toLocaleString() + ' days)' : '') : null,
                ].filter(Boolean);
                const lines = d.tiles.map(t => '• ' + t.label + ': **' + t.value + '**' + (t.sub ? ' (' + t.sub + ')' : ''));
                return head.concat('', lines, '', '_FFVII Ever Crisis · EOS Player Stats_').join('\n');
            };

            const draw = () => {
                const W = 1200, H = 675, S = 2;
                const c = document.createElement('canvas'); c.width = W * S; c.height = H * S;
                const g = c.getContext('2d'); g.scale(S, S);
                const font = (w, px) => w + ' ' + px + 'px system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
                const fit = (txt, px, weight, max) => { let p = px; g.font = font(weight, p); while (g.measureText(txt).width > max && p > 10) { p--; g.font = font(weight, p); } };
                const box = (x, y, w, h, r) => { g.beginPath(); if (g.roundRect) g.roundRect(x, y, w, h, r); else g.rect(x, y, w, h); g.fill(); };
                const bg = g.createLinearGradient(0, 0, W, H); bg.addColorStop(0, '#2a1f44'); bg.addColorStop(1, '#5a3f96');
                g.fillStyle = bg; g.fillRect(0, 0, W, H);
                // Header
                g.fillStyle = '#ffffff'; fit(d.name, 46, 700, 760); g.fillText(d.name, 48, 84);
                const meta = [d.guild, d.rank ? 'Rank ' + d.rank : null, d.since ? 'Playing since ' + d.since + (d.days != null ? ' · ' + d.days.toLocaleString() + ' days' : '') : null].filter(Boolean).join('   ·   ');
                g.fillStyle = '#d9cdf2'; fit(meta, 22, 500, W - 96); g.fillText(meta, 48, 122);
                g.fillStyle = '#b9a9d6'; g.font = font(700, 16); g.textAlign = 'right'; g.fillText('FFVII EVER CRISIS', W - 48, 60); g.textAlign = 'left';
                // Tiles: 4 columns x 3 rows
                const cols = 4, gap = 16, x0 = 48, y0 = 160, tw = (W - 96 - gap * (cols - 1)) / cols, th = 140;
                d.tiles.forEach((t, i) => {
                    const x = x0 + (i % cols) * (tw + gap), y = y0 + Math.floor(i / cols) * (th + gap);
                    g.fillStyle = 'rgba(255,255,255,0.09)'; box(x, y, tw, th, 14);
                    const label = t.label.toUpperCase();
                    g.fillStyle = '#cbbbe8'; fit(label, 15, 700, tw - 36); g.fillText(label, x + 18, y + 34);
                    g.fillStyle = '#ffffff'; fit(t.value, 40, 700, tw - 36); g.fillText(t.value, x + 18, y + 84);
                    if (t.sub) { g.fillStyle = '#b9a9d6'; fit(t.sub, 16, 500, tw - 36); g.fillText(t.sub, x + 18, y + 116); }
                });
                g.fillStyle = '#9c8cc0'; g.font = font(500, 15); g.fillText('EOS Player Stats · FFVIIEC Tools', 48, H - 28);
                return c;
            };

            let canvas = null;
            const blob = () => new Promise(r => canvas.toBlob(r, 'image/png'));
            btn.addEventListener('click', () => {
                canvas = draw();
                document.getElementById('eos-share-img').src = canvas.toDataURL('image/png');
                const probe = new File([''], fileName, { type: 'image/png' });
                document.getElementById('eos-share-native').hidden = !(navigator.canShare && navigator.canShare({ files: [probe] }));
                bootstrap.Modal.getOrCreateInstance(document.getElementById('eos-share-modal')).show();
            });
            document.getElementById('eos-share-copytext').addEventListener('click', async () => {
                try { await navigator.clipboard.writeText(text()); say('Text copied'); } catch { say('Copy failed'); }
            });
            document.getElementById('eos-share-copyimg').addEventListener('click', async () => {
                try { await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob() })]); say('Image copied'); }
                catch { say('This browser can’t copy images; use Save image'); }
            });
            document.getElementById('eos-share-download').addEventListener('click', async () => {
                const a = document.createElement('a'); a.href = URL.createObjectURL(await blob()); a.download = fileName; a.click();
                setTimeout(() => URL.revokeObjectURL(a.href), 1000);
            });
            document.getElementById('eos-share-native').addEventListener('click', async () => {
                try { await navigator.share({ files: [new File([await blob()], fileName, { type: 'image/png' })], text: text() }); } catch { }
            });
        })();
    </script>
}
